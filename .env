# Production defaults (committed). These get baked into `yarn build`.
# The app calls the PHP API on the SAME origin at /api, so no host is hard-coded.
# For LOCAL development, .env.local (gitignored) overrides REACT_APP_API_BASE
# to point at the local PHP server (http://localhost:8010/api).
WDS_SOCKET_PORT=443
REACT_APP_API_BASE=/api


