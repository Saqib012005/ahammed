# ---------------------------------------------------------------------------
# Apache config for Hostinger shared hosting.
#
# The React app is a single-page app: every non-file, non-API request must be
# served index.html so client-side routing (including the hidden /admin route)
# works on a hard refresh or direct link. Requests under /api are handled by the
# PHP backend and must NOT be rewritten to index.html.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let the PHP API handle itself.
  RewriteRule ^api/ - [L]

  # Don't rewrite requests for real files or directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache the hashed static assets; never cache index.html.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
